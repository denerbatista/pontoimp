<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- é isto que faz o aviso abrir a tela por cima do bloqueio, como o despertador -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- USE_EXACT_ALARM: concedida na instalação, para app cuja função é despertar.
         SCHEDULE_EXACT_ALARM cobre o Android 12, onde a primeira não existe. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- alguns fabricantes (Samsung entre eles) só deixam a tela de alarme subir
         sobre outros apps com esta permissão, concedida numa tela do sistema -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.PontoImp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- tela do alarme: aparece sobre o bloqueio e acorda o aparelho -->
        <activity
            android:name=".TelaAlarme"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Tema.PontoImp.Alarme" />

        <receiver
            android:name=".ReceptorAlarme"
            android:exported="false" />

        <receiver
            android:name=".ReceptorBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
